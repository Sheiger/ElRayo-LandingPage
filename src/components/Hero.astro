---
import { Image } from 'astro:assets';
import furgoneta from '../assets/furgoneta.jpg';
import BotonWhatsapp from './ui/BotonWhatsapp.astro';

const ventajas = [
  { titulo: 'Recojo a domicilio', detalle: 'Vamos por tu carga' },
  { titulo: 'Embalaje incluido', detalle: 'Protegida para el viaje' },
  { titulo: '+70 destinos', detalle: 'Costa, sierra y selva' },
];
---
<section class="relative overflow-hidden bg-white pt-24 pb-16 lg:pt-36 lg:pb-24">
  <div
    class="pointer-events-none absolute -right-32 -top-32 h-112 w-md rounded-full bg-rayo-mist blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">

      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-rayo-mist px-4 py-1.5 text-xs font-semibold tracking-wide text-carbon uppercase motion-safe:animate-entrar">
          <span class="h-1.5 w-1.5 rounded-full bg-rayo"></span>
          Envíos desde Lima a todo el Perú
        </span>

        <h1 class="mt-6 font-display text-4xl leading-[1.1] font-bold text-carbon sm:text-5xl lg:text-6xl motion-safe:animate-entrar [--retraso:80ms]">
          Recogemos, embalamos y enviamos&nbsp;
          <span class="relative inline-block">
            <span class="relative z-10">tu carga</span>
            <span class="absolute inset-x-0 bottom-1 z-0 h-3 bg-rayo lg:h-4 origin-left motion-safe:animate-subrayar" aria-hidden="true"></span>
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-pizarra motion-safe:animate-entrar [--retraso:160ms]">
          Vamos por tu encomienda hasta tu puerta, la embalamos como corresponde
          y la hacemos llegar a su destino. Tú solo nos escribes.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center motion-safe:animate-entrar [--retraso:240ms]">
          <BotonWhatsapp
            mensaje="Hola, quiero cotizar un envío desde Lima."
            texto="Cotizar mi envío"
            clase="justify-center px-6 py-3.5 text-base"
          />
          <a
            href="#destinos"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-hairline px-6 py-3.5 text-base font-semibold text-carbon transition-colors hover:border-carbon hover:bg-rayo-mist"
          >
            Ver destinos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <dl class="mt-12 grid grid-cols-3 gap-4 border-t border-hairline pt-8 motion-safe:animate-entrar [--retraso:320ms]">
          {ventajas.map((v) => (
            <div>
              <dt class="font-display text-sm font-semibold text-carbon sm:text-base">{v.titulo}</dt>
              <dd class="mt-1 text-xs text-pizarra sm:text-sm">{v.detalle}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="relative order-first lg:order-last">
        <div class="absolute -bottom-3 -left-3 h-full w-full rounded-2xl bg-rayo lg:-bottom-4 lg:-left-4 lg:rounded-3xl motion-safe:animate-bloque" aria-hidden="true"></div>
        <Image
          src={furgoneta}
          alt="Furgoneta de El Rayo Logistic cargando encomiendas en Lima"
          widths={[480, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-video w-full rounded-2xl object-cover shadow-lg sm:aspect-3/2 lg:aspect-4/3 lg:rounded-3xl"
        />
      </div>

    </div>
  </div>
</section>
---
import { Image } from 'astro:assets';
import fondo from '../assets/hero-fondo.jpg';
import fondoMovil from '../assets/hero-fondo-movil.jpg';
import { linkWhatsapp } from '../data/empresa';

const items = [
  {
    titulo: 'Paquetería',
    icono: 'M21 8v13H3V8 M1 3h22v5H1z M10 12h4',
  },
  {
    titulo: 'Carga',
    icono: 'M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2 M15 18H9 M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14 M5 18a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M15 18a2 2 0 1 0 4 0a2 2 0 1 0-4 0',
  },
  {
    titulo: 'Mudanzas',
    icono: 'M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .71-1.53l7-6a2 2 0 0 1 2.58 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z',
  },
  {
    titulo: 'Envíos nacionales',
    icono: 'M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z M9 4v13 M15 7v13',
  },
];
---
<section class="relative flex min-h-152 items-center overflow-hidden pt-20 pb-5 lg:min-h-176 lg:pt-24 lg:pb-16">

  <picture>
    <source
      media="(min-width: 1024px)"
      srcset={encodeURI(fondo.src)}
      width={fondo.width}
      height={fondo.height}
    />
    <Image
      src={fondoMovil}
      alt="Furgoneta de El Rayo Logistic en carretera"
      widths={[480, 768, 1080]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
  </picture>

  <div class="absolute inset-0 -z-10 bg-carbon/70 lg:hidden" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10 hidden bg-linear-to-r from-carbon via-carbon/85 via-40% to-transparent lg:block"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-7xl px-5 py-4 lg:px-8">
    <div class="max-w-xl">

      <h1 class="font-display text-4xl leading-[1.1] font-bold text-white sm:text-5xl lg:text-6xl motion-safe:animate-entrar">
        Tu carga, en<br />
        <span class="text-rayo">buenas manos</span>
      </h1>

      <p class="mt-5 max-w-md text-lg leading-relaxed text-white/85 lg:text-xl motion-safe:animate-entrar [--retraso:80ms]">
        Envíos rápidos, seguros y confiables a todo el Perú.
      </p>

      <ul class="mt-9 grid max-w-md grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4 sm:gap-x-2 motion-safe:animate-entrar [--retraso:160ms]">
        {items.map((item) => (
          <li class="flex flex-col items-start gap-2 sm:items-center sm:text-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-rayo" aria-hidden="true">
              <path d={item.icono} />
            </svg>
            <span class="text-sm font-medium text-white">{item.titulo}</span>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center motion-safe:animate-entrar [--retraso:240ms]">
        <a
          href={linkWhatsapp('Hola, quiero cotizar un envío desde Lima.')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-rayo px-6 py-3.5 text-base font-semibold text-carbon transition-all duration-200 hover:-translate-y-0.5 hover:bg-rayo-deep active:translate-y-0"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <path d="M21 8v13H3V8 M1 3h22v5H1z M10 12h4" />
          </svg>
          Cotiza tu envío
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>

        <a
          href="#destinos"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-6 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition-colors duration-200 hover:border-white hover:bg-white/10"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
          </svg>
          Ver destinos
        </a>
      </div>

    </div>
  </div>
</section>
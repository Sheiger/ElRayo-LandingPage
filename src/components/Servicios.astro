---
import { Image } from 'astro:assets';
import { linkWhatsapp } from '../data/empresa';
import embalaje from '../assets/servicios/embalaje.jpg';
import embaleje1 from '../assets/servicios/embalaje1.jpg';
import carga from '../assets/servicios/carga.jpg';
import carga1 from '../assets/servicios/carga1.jpg';

const fotos = [
  { src: embalaje, alt: 'Encomienda siendo embalada por el equipo de El Rayo Logistic' },
  { src: embaleje1, alt: 'Carga embalada lista para su envío' },
  { src: carga, alt: 'Furgoneta de El Rayo Logistic recogiendo una encomienda' },
  { src: carga1, alt: 'Furgoneta de El Rayo Logistic recogiendo una encomienda' },
];

const iconos = {
  bolsa: 'M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z M3 6h18 M16 10a4 4 0 0 1-8 0',
  camion: 'M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2 M15 18H9 M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14 M5 18a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M15 18a2 2 0 1 0 4 0a2 2 0 1 0-4 0',
  casa: 'M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .71-1.53l7-6a2 2 0 0 1 2.58 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z',
};

const flecha = 'M5 12h14M13 6l6 6-6 6';

const secundarios = [
  {
    icono: iconos.bolsa,
    titulo: 'Compras en Lima por encargo',
    texto: '¿Viste algo en Saga Falabella, Sodimac o Ripley? Haz que llegue a nuestra oficina: revisamos que esté en buen estado, lo embalamos y te lo enviamos.',
    mensaje: 'Hola, quiero comprar un producto en Lima y que me lo envíen a mi ciudad.',
  },
  {
    icono: iconos.camion,
    titulo: 'Recojo a proveedores',
    texto: 'Si compras mercadería en Lima, la recogemos de tu proveedor y la despachamos a tu ciudad. Sin que tengas que viajar.',
    mensaje: 'Hola, necesito que recojan mercadería de mi proveedor en Lima.',
  },
];
---
<section id="servicios" class="bg-humo py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">

    <div class="max-w-2xl">
      <span data-reveal class="flex items-center gap-3 text-sm font-semibold tracking-wide text-pizarra uppercase">
        <span class="h-0.5 w-8 bg-rayo"></span>
        Servicios
      </span>
      <h2 data-reveal data-delay="0.05" class="mt-4 font-display text-3xl font-bold text-carbon sm:text-4xl lg:text-5xl">
        Nos encargamos de todo el camino
      </h2>
      <p data-reveal data-delay="0.1" class="mt-4 text-lg leading-relaxed text-pizarra">
        Desde que la carga sale de tu puerta hasta que llega a su destino,
        tratas con una sola empresa, de principio a fin.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3 lg:grid-rows-2">

      <article
        data-reveal
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-hairline bg-white transition-shadow duration-300 hover:shadow-lg lg:row-span-2"
      >
        <div data-carrusel class="relative aspect-16/10 overflow-hidden lg:aspect-auto lg:min-h-0 lg:flex-1">
          {fotos.map((f, i) => (
            <Image
              src={f.src}
              alt={f.alt}
              widths={[400, 700]}
              sizes="(max-width: 1024px) 100vw, 33vw"
              data-slide
              aria-hidden={i === 0 ? undefined : 'true'}
              class:list={[
                'absolute inset-0 h-full w-full object-cover transition-opacity duration-700',
                i === 0 ? 'opacity-100' : 'opacity-0',
              ]}
            />
          ))}

          {fotos.length > 1 && (
            <div class="absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 items-center gap-1 rounded-full bg-carbon/40 px-2 backdrop-blur-sm">
              {fotos.map((_, i) => (
                <button
                  type="button"
                  data-punto={i}
                  aria-label={`Ver foto ${i + 1} de ${fotos.length}`}
                  aria-current={i === 0 ? 'true' : undefined}
                  class="group/punto flex h-6 items-center px-1"
                >
                  <span class="block h-1.5 w-1.5 rounded-full bg-white/60 transition-all duration-300 group-aria-current/punto:w-5 group-aria-current/punto:bg-white"></span>
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="p-7">
          <span class="inline-block rounded-full bg-rayo px-3 py-1 text-xs font-semibold text-carbon">
            Servicio principal
          </span>
          <h3 class="mt-4 font-display text-2xl font-semibold text-carbon">Encomiendas y carga</h3>
          <p class="mt-2 leading-relaxed text-pizarra">
            Recogemos tu carga en tu casa u oficina, la embalamos como corresponde
            y la enviamos a más de 70 ciudades del país.
          </p>
          <a
            href={linkWhatsapp('Hola, quiero cotizar un envío de encomienda desde Lima.')}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-carbon after:absolute after:inset-0 after:rounded-2xl"
          >
            Cotizar mi envío
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1">
              <path d={flecha} />
            </svg>
          </a>
        </div>
      </article>

      {secundarios.map((s, i) => (
        <article
          data-reveal
          data-delay={(i + 1) * 0.1}
          class="group relative flex flex-col rounded-2xl border border-hairline bg-white p-7 transition-shadow duration-300 hover:shadow-lg"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-rayo-mist text-carbon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
              <path d={s.icono} />
            </svg>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold text-carbon">{s.titulo}</h3>
          <p class="mt-2 flex-1 leading-relaxed text-pizarra">{s.texto}</p>
          <a
            href={linkWhatsapp(s.mensaje)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-carbon after:absolute after:inset-0 after:rounded-2xl"
          >
            Cotizar este servicio
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1">
              <path d={flecha} />
            </svg>
          </a>
        </article>
      ))}

      <article
        data-reveal
        data-delay="0.3"
        class="group relative flex flex-col justify-between gap-6 rounded-2xl bg-carbon p-7 text-white sm:flex-row sm:items-center lg:col-span-2"
      >
        <div class="flex gap-5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-rayo text-carbon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
              <path d={iconos.casa} />
            </svg>
          </div>
          <div>
            <h3 class="font-display text-xl font-semibold">Mudanzas pequeñas</h3>
            <p class="mt-2 max-w-md leading-relaxed text-white/70">
                Trasladamos departamentos y oficinas dentro de Lima con nuestra propia
                furgoneta. Cargamos, llevamos y descargamos.
            </p>
          </div>
        </div>
        <a
          href={linkWhatsapp('Hola, quiero cotizar una mudanza pequeña dentro de Lima. Salgo de ___ y voy a ___.')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-rayo after:absolute after:inset-0 after:rounded-2xl"
        >
          Cotizar mudanza
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1">
            <path d={flecha} />
          </svg>
        </a>
      </article>

    </div>
  </div>
</section>

<script>
  const carruseles = document.querySelectorAll<HTMLElement>('[data-carrusel]');

  carruseles.forEach((carrusel) => {
    const slides = carrusel.querySelectorAll<HTMLImageElement>('[data-slide]');
    const puntos = carrusel.querySelectorAll<HTMLButtonElement>('[data-punto]');
    if (slides.length < 2) return;

    let actual = 0;
    let temporizador: number | undefined;
    let visible = false;
    let detenido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function mostrar(indice: number) {
      slides[actual].classList.replace('opacity-100', 'opacity-0');
      slides[actual].setAttribute('aria-hidden', 'true');
      puntos[actual]?.removeAttribute('aria-current');

      actual = indice;

      slides[actual].classList.replace('opacity-0', 'opacity-100');
      slides[actual].removeAttribute('aria-hidden');
      puntos[actual]?.setAttribute('aria-current', 'true');
    }

    function iniciar() {
      if (detenido || !visible || temporizador) return;
      temporizador = window.setInterval(() => {
        mostrar((actual + 1) % slides.length);
      }, 4000);
    }

    function pausar() {
      clearInterval(temporizador);
      temporizador = undefined;
    }

    puntos.forEach((punto, i) => {
      punto.addEventListener('click', () => {
        detenido = true;
        pausar();
        mostrar(i);
      });
    });

    carrusel.addEventListener('mouseenter', pausar);
    carrusel.addEventListener('mouseleave', iniciar);

    new IntersectionObserver(([entrada]) => {
      visible = entrada.isIntersecting;
      if (visible) iniciar();
      else pausar();
    }).observe(carrusel);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pausar();
      else iniciar();
    });
  });
</script>
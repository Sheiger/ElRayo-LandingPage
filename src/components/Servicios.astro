---
import { Image } from 'astro:assets';
import { servicios } from '../data/servicios';
import { linkWhatsapp } from '../data/empresa';

const atributos = ['Rápido', 'Seguro', 'Confiable'];
---
<section id="servicios" class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">

    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <span data-reveal class="flex items-center gap-3 text-sm font-semibold tracking-wide text-pizarra uppercase">
          <span class="h-0.5 w-8 bg-rayo"></span>
          Nuestros servicios
        </span>
        <h2 data-reveal data-delay="0.05" class="mt-4 max-w-xl font-display text-3xl font-bold text-carbon sm:text-4xl lg:text-5xl">
          Todo lo que necesitas enviar, en un solo lugar.
        </h2>
      </div>

      <ul class="flex shrink-0 flex-wrap items-center gap-x-3 gap-y-2 text-sm font-medium text-carbon sm:text-base">
        <li aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-rayo">
            <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
          </svg>
        </li>
        {atributos.map((a, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-rayo"></li>}
            <li>{a}</li>
          </>
        ))}
      </ul>
    </div>

    <div data-carrusel data-reveal data-delay="0.1" class="relative mt-12">
      <ul
        data-carril
        tabindex="0"
        role="region"
        aria-label="Servicios, lista desplazable"
        class="sin-barra flex snap-x snap-mandatory scroll-px-5 gap-5 overflow-x-auto scroll-smooth mask-[linear-gradient(to_right,transparent,black_1.5rem,black_calc(100%-1.5rem),transparent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-rayo md:grid md:grid-cols-2 md:overflow-visible md:mask-none lg:grid-cols-3 xl:grid-cols-5"
      >
      {servicios.map((s) => (
        <li class="w-[75vw] shrink-0 snap-start sm:w-[45vw] md:w-auto">
          <article class="group relative flex h-full flex-col rounded-2xl border border-hairline bg-white transition-shadow duration-300 hover:shadow-lg">
            <div class="relative">
              <Image
                src={s.foto}
                alt={s.alt}
                widths={[320, 480]}
                sizes="(max-width: 768px) 75vw, (max-width: 1280px) 33vw, 20vw"
                class="aspect-4/3 w-full rounded-t-2xl object-cover"
              />
              <span class="absolute bottom-0 left-5 flex h-12 w-12 translate-y-1/2 items-center justify-center rounded-xl bg-rayo text-carbon shadow-md transition-transform duration-300 group-hover:translate-y-[calc(50%-0.25rem)]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
                  <path d={s.icono} />
                </svg>
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5 pt-10">
              <h3 class="font-display text-lg leading-snug font-semibold text-carbon">{s.titulo}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-pizarra">{s.texto}</p>
              <a
                href={linkWhatsapp(s.mensaje)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-carbon after:absolute after:inset-0 after:rounded-2xl"
              >
                Cotizar
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </article>
        </li>
        ))}
      </ul>
      <div data-pista hidden class="relative mx-auto mt-6 h-1 w-32 overflow-hidden rounded-full bg-hairline md:hidden">
        <span data-pulgar class="absolute inset-y-0 left-0 rounded-full bg-rayo transition-[left] duration-150 ease-out"></span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((carrusel) => {
    const carril = carrusel.querySelector<HTMLElement>('[data-carril]');
    const pista = carrusel.querySelector<HTMLElement>('[data-pista]');
    const pulgar = carrusel.querySelector<HTMLElement>('[data-pulgar]');
    if (!carril || !pista || !pulgar) return;

    const actualizar = () => {
      const { scrollLeft, scrollWidth, clientWidth } = carril;
      const recorrido = scrollWidth - clientWidth;

      if (recorrido < 4) {
        pista.hidden = true;
        return;
      }

      pista.hidden = false;
      const proporcion = (clientWidth / scrollWidth) * 100;
      pulgar.style.width = `${proporcion}%`;
      pulgar.style.left = `${(scrollLeft / recorrido) * (100 - proporcion)}%`;
    };

    carril.addEventListener('scroll', actualizar, { passive: true });
    new ResizeObserver(actualizar).observe(carril);
  });
</script>
---
import { Image } from 'astro:assets';
import fondo from '../assets/carretera-contactanos.webp';
import telefono from '../assets/manos-con-celular.png';
import { linkWhatsapp, empresa } from '../data/empresa';

const garantias = [
  {
    titulo: 'Atención personalizada',
    icono: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z M9 12l2 2 4-4',
  },
  {
    titulo: 'Respuesta rápida',
    icono: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z M12 6v6l4 2',
  },
  {
    titulo: 'Clientes satisfechos',
    icono: 'M7 10v12 M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z',
  },
];
---
<section id="contacto" class="relative overflow-hidden">

  <Image
    src={fondo}
    alt=""
    widths={[768, 1200]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-0 -z-10 bg-carbon/80" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 py-14 lg:px-0 lg:py-0">
    <div class="flex flex-col items-center gap-10 text-center lg:grid lg:grid-cols-5 lg:items-center lg:gap-8 lg:text-left xl:gap-10">

      <Image
        src={telefono}
        alt=""
        widths={[240, 400]}
        sizes="240px"
        data-reveal
        class="hidden w-full max-w-52 justify-self-center align-bottom lg:col-span-1 lg:block xl:max-w-72"
      />

      <div class="lg:col-span-2">
        <h2 data-reveal class="font-display text-3xl font-bold text-white sm:text-4xl">
          ¿Necesitas enviar algo?
        </h2>
        <p data-reveal data-delay="0.05" class="mt-3 text-lg text-white/80">
          Escríbenos por WhatsApp y cotiza al instante.
        </p>
        <a
          data-reveal
          data-delay="0.1"
          href={linkWhatsapp('Hola, quiero cotizar un envío desde Lima.')}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-7 inline-flex items-center gap-2.5 rounded-full bg-whatsapp px-7 py-4 text-base font-semibold text-white shadow-lg shadow-black/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-whatsapp-deep active:translate-y-0"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.13c-.25.69-1.44 1.32-1.99 1.37-.53.05-1.02.24-3.45-.72-2.9-1.14-4.73-4.1-4.87-4.29-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.09.99-2.37.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.65.49.24.58.81 2 .88 2.14.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.29-.12.57.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.41.29.14.45.12.62-.07.17-.19.71-.83.9-1.12.19-.29.38-.24.64-.14.26.09 1.66.78 1.94.93.29.14.48.21.55.33.07.12.07.69-.18 1.38Z" />
          </svg>
          Cotizar por WhatsApp
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <p data-reveal data-delay="0.1" class="mt-2 pl-8 text-xs transition-all duration-200  text-white/60">{empresa.horario}</p>
      </div>

      <div class="flex flex-col items-center gap-8 lg:col-span-2 lg:flex-row lg:items-start lg:justify-end lg:gap-8">
        <ul data-reveal data-delay="0.15" class="grid grid-cols-3 gap-5 sm:gap-8 lg:-mt-2 lg:-ml-8">
          {garantias.map((g) => (
            <li class="flex flex-col items-center gap-2 text-center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-rayo" aria-hidden="true">
                <path d={g.icono} />
              </svg>
              <span class="max-w-20 text-xs leading-tight font-medium text-white sm:max-w-24 sm:text-sm">
                {g.titulo}
              </span>
            </li>
          ))}
        </ul>

        <p data-reveal data-delay="0.2" class="relative text-center font-script text-3xl leading-tight font-bold tracking-tight text-rayo lg:mt-14 lg:text-4xl lg:-ml-8 lg:mr-12">
          El Rayo,<br />siempre&nbsp;contigo
          <svg viewBox="0 0 200 12" fill="none" preserveAspectRatio="none" class="absolute -bottom-2 right-0 h-2 w-full text-rayo" aria-hidden="true">
            <path d="M2 8c40-6 100-7 196-3" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          </svg>
        </p>
      </div>

    </div>
  </div>
</section>
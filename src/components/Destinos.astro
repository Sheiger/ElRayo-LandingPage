---
import { destinos, zonas } from '../data/destinos';
import { normalizar } from '../utils/texto';
import { linkWhatsapp } from '../data/empresa';

const hayDelivery = destinos.some((d) => d.delivery);
const claseFiltro =
  'rounded-full border border-white/15 px-4 py-2 text-sm font-medium text-white/80 transition-colors hover:border-white/40 aria-pressed:border-rayo aria-pressed:bg-rayo aria-pressed:text-carbon';
---
<section id="destinos" class="bg-carbon py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">

    <div class="max-w-2xl">
      <span data-reveal class="flex items-center gap-3 text-sm font-semibold tracking-wide text-white/60 uppercase">
        <span class="h-0.5 w-8 bg-rayo"></span>
        Destinos
      </span>
      <h2 data-reveal data-delay="0.05" class="mt-4 font-display text-3xl font-bold sm:text-4xl lg:text-5xl">
        Llegamos a más de 70 ciudades del Perú
      </h2>
      <p data-reveal data-delay="0.1" class="mt-4 text-lg leading-relaxed text-white/70">
        Busca la tuya. Todos los envíos salen desde Lima.
      </p>
    </div>

    <div data-reveal data-delay="0.15" class="mt-10 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="relative w-full lg:max-w-sm">
        <label for="buscar-destino" class="sr-only">Buscar ciudad o departamento</label>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-white/40" aria-hidden="true">
          <path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z M21 21l-4.35-4.35" />
        </svg>
        <input
          id="buscar-destino"
          type="search"
          autocomplete="off"
          placeholder="Busca tu ciudad o departamento"
          class="w-full rounded-xl border border-white/10 bg-white/5 py-3.5 pr-4 pl-12 text-white placeholder:text-white/40 focus:border-rayo focus:outline-none"
        />
      </div>

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por zona">
        <button type="button" data-zona-filtro="todas" aria-pressed="true" class={claseFiltro}>Todas</button>
        {zonas.map((z) => (
          <button type="button" data-zona-filtro={z.id} aria-pressed="false" class={claseFiltro}>{z.nombre}</button>
        ))}
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-2 text-sm text-white/50">
      <p id="contador-destinos" aria-live="polite">{destinos.length} destinos</p>
      {hayDelivery && (
        <p class="flex items-center gap-2">
          <span class="rounded-full bg-rayo/15 px-2 py-0.5 text-xs font-semibold text-rayo">Delivery</span>
          a domicilio disponible, con costo adicional
        </p>
      )}
    </div>

    <ul data-reveal data-delay="0.2" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      {destinos.map((d) => (
        <li
          data-destino
          data-zona={d.zona}
          data-busqueda={normalizar([d.nombre, d.departamento ?? '', ...d.alias].join(' '))}
        >
          <div class="flex h-full items-center justify-between gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-3">
            <div class="min-w-0">
              <p class="truncate font-medium">{d.nombre}</p>
              {d.departamento && <p class="truncate text-xs text-white/50">{d.departamento}</p>}
            </div>
            {d.delivery && (
              <span class="shrink-0 rounded-full bg-rayo/15 px-2 py-0.5 text-[10px] font-semibold text-rayo">Delivery</span>
            )}
          </div>
        </li>
      ))}
    </ul>

    <div id="destinos-vacio" hidden class="mt-4 rounded-2xl border border-dashed border-white/15 p-8 text-center">
      <p class="font-display text-lg font-semibold">No encontramos esa ciudad en la lista</p>
      <p class="mt-2 text-white/60">Escríbenos igual y te confirmamos si podemos hacerla llegar.</p>
      <a
        href={linkWhatsapp('Hola, quiero saber si hacen envíos desde Lima a mi ciudad.')}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-rayo"
      >
        Consultar por WhatsApp
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  import { normalizar } from '../utils/texto';
  import { linkWhatsapp } from '../data/empresa';

  const input = document.querySelector<HTMLInputElement>('#buscar-destino');
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-zona-filtro]');
  const items = document.querySelectorAll<HTMLLIElement>('[data-destino]');
  const contador = document.querySelector('#contador-destinos');
  const vacio = document.querySelector<HTMLElement>('#destinos-vacio');
  const enlaceVacio = vacio?.querySelector('a');

  let zonaActiva = 'todas';

  function marcarZona(id: string) {
    zonaActiva = id;
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.zonaFiltro === id)));
  }

  function filtrar() {
    const consulta = normalizar(input?.value ?? '');
    let visibles = 0;

    items.forEach((item) => {
      const enZona = zonaActiva === 'todas' || item.dataset.zona === zonaActiva;
      const coincide = !consulta || (item.dataset.busqueda ?? '').includes(consulta);
      item.hidden = !(enZona && coincide);
      if (!item.hidden) visibles++;
    });

    if (contador) contador.textContent = `${visibles} ${visibles === 1 ? 'destino' : 'destinos'}`;
    if (vacio) vacio.hidden = visibles > 0;
    if (enlaceVacio && input) {
      enlaceVacio.href = linkWhatsapp(
        `Hola, quiero saber si hacen envíos desde Lima a ${input.value.trim()}.`
      );
    }
  }

  input?.addEventListener('input', () => {
    if (zonaActiva !== 'todas') marcarZona('todas');
    filtrar();
  });

  botones.forEach((boton) => {
    boton.addEventListener('click', () => {
      if (input) input.value = '';
      marcarZona(boton.dataset.zonaFiltro ?? 'todas');
      filtrar();
    });
  });
</script>